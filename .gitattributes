# Forzar finales de linea LF en shell scripts — los contenedores Linux
# fallan con CRLF (p.ej. "\r: not found" en scripts/replace-placeholder.sh)
*.sh text eol=lf
*.sql text eol=lf

# Windows
*.bat text eol=crlf
*.cmd text eol=crlf

# Binarios de seguridad (evitar que git los corrompa)
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
